# ============================================================
# NEXUS AI — environment template. Copy to .env (never commit .env)
# ============================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Optional bearer token protecting all /api routes (except /api/status + YouTube OAuth callback).
# The frontend reads it from localStorage 'nexus_api_token' (Settings → API TOKEN).
NEXUS_API_TOKEN=
# Key used to AES-256-GCM-encrypt stored YouTube OAuth tokens. Change this in production.
NEXUS_ENCRYPTION_KEY=change-me-32-byte-key

# ---------- AI Provider ----------
# DEFAULT: mock — fully offline, rule-based + template content generators (free).
# Options: mock | ollama | openai | groq | gemini | anthropic
DEFAULT_AI_PROVIDER=mock

# Ollama — FREE local LLM. Install: https://ollama.com then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq — FREE tier: https://console.groq.com (OpenAI-compatible endpoint, auto-wired)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — FREE tier: https://aistudio.google.com (OpenAI-compatible endpoint, auto-wired)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI — paid
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic — paid
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---------- Storage & permissions ----------
# Root folder for all NEXUS output (Projects/Videos/Audio/Images/Thumbnails/Scripts/Exports/Logs
# are created inside on boot). Windows example: D:/NexusAI
NEXUS_STORAGE_DIR=
# Extra approved dirs for file tools (comma-separated). The storage dir is always approved.
NEXUS_APPROVED_DIRS=
# SQLite file location (NEXUS_DATA_DIR/nexus.db)
NEXUS_DATA_DIR=./data
# App allowlist for the app_control tool (JSON: name -> URL or command)
APP_ALIASES={"youtube":"https://youtube.com","vscode":"code"}

# ---------- Publishing ----------
# AUTO publishes videos immediately; APPROVAL queues them for review. Default: approval
AUTO_PUBLISH_MODE=approval
WAKE_WORD_DEFAULT=Nexus

# ---------- YouTube (optional — needs Google Cloud OAuth) ----------
# Console → Credentials → OAuth 2.0 Client (Web) → add the redirect URI below.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth2callback

# ---------- Voice (optional) ----------
STT_PROVIDER=webspeech   # webspeech (browser, free) | whisper (not yet wired)
TTS_PROVIDER=webspeech   # webspeech (browser, free) | elevenlabs (not yet wired)

# ---------- Optional external services ----------
# Postgres — support pending; when set with a postgres:// URL the backend logs and still uses SQLite.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
