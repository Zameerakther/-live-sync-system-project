# NEXUS AI Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=nexus_ai_super_secret_jwt_key_2026

# AI Provider Configuration (Default: mock for offline use)
DEFAULT_AI_PROVIDER=mock # Options: mock, openai, gemini, anthropic, ollama
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Speech & Audio Providers
STT_PROVIDER=webspeech # Options: webspeech, whisper
TTS_PROVIDER=webspeech # Options: webspeech, elevenlabs

# YouTube API / OAuth 2.0 Credentials
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth2callback

# System Paths & Permissions
NEXUS_STORAGE_DIR=D:/NexusAI
AUTO_PUBLISH_MODE=approval # Options: auto, approval
WAKE_WORD_DEFAULT=Nexus

# Database & Cache (Optional / Docker)
DATABASE_URL=postgresql://nexus:nexuspassword@localhost:5432/nexus_ai_db
REDIS_URL=redis://localhost:6379

# New backend configuration
NEXUS_DATA_DIR=./data
NEXUS_APPROVED_DIRS=
NEXUS_ENCRYPTION_KEY=change-me-32-byte-key
NEXUS_API_TOKEN=
OLLAMA_MODEL=llama3.2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-3-5-haiku-latest
APP_ALIASES={"youtube":"https://youtube.com","vscode":"code"}
